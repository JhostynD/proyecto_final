# ================================================================
# FILA CERO — Plantilla de Variables de Entorno (Backend)
# IMPORTANTE: Nunca subas valores ni contraseñas reales a este archivo.
# ================================================================

# Entorno y servidor
NODE_ENV=production
PORT=3000

# Base de datos (TiDB Cloud Starter o MySQL)
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=turnos_db
DB_USER=tu_usuario_tidb.root
DB_PASSWORD=tu_contrasena_de_tidb_aqui
DB_SSL=true

# Seguridad y Autenticación JWT
JWT_SECRET=genera_un_secreto_largo_y_aleatorio_minimo_64_caracteres
FRONTEND_URL=https://tu-frontend.vercel.app
CORS_ORIGINS=https://tu-frontend.vercel.app
CSP_MODE=report-only

# Modo Demo para Pruebas / Sustentación:
# Si es 'true', permite a usuarios recién creados iniciar sesión sin verificar correo.
# IMPORTANTE: Desactivar (false) o eliminar cuando Brevo esté configurado con EMAIL_ENABLED=true.
ALLOW_UNVERIFIED_LOGIN=false

# Servicio de Correo Transaccional (Brevo SMTP)
EMAIL_ENABLED=false
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario_smtp@ejemplo.com
SMTP_PASS=tu_clave_maestra_smtp
EMAIL_FROM=notificaciones@tudominio.com

# Base de datos para pruebas locales automatizadas (opcional)
DB_NAME_TEST=fila_cero_test
DB_USER_TEST=root
DB_PASSWORD_TEST=
DB_HOST_TEST=127.0.0.1
DB_PORT_TEST=3306
